# Copy this file to back-end/.env and fill in the values.
# back-end/.env is gitignored and never copied into the Docker image.

# Required: MongoDB connection string.
# For MongoDB Atlas, copy the SRV/standard URI from
# Atlas -> Database -> Connect -> Drivers (Node.js).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=BudgetLife

# Optional: port the Express server listens on. Defaults to 3000.
# docker-compose already sets PORT=3000, so you usually don't need this.
PORT=3000

# Optional: JWT signing secret. Code falls back to "budgetlife-dev-secret"
# when unset, which is fine for local dev but MUST be overridden in production.
JWT_SECRET=replace-me-with-a-long-random-string

# Optional: JWT lifetime. Defaults to "7d". Accepts any value supported by
# the jsonwebtoken library.
JWT_EXPIRES_IN=7d
